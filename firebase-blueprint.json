{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated operator profile in QueueSense.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the operator.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the operator.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "QueueSession": {
      "title": "QueueSession",
      "description": "Aggregated monitoring session summary recorded by an operator.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "locationLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "startTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "endTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "durationSeconds": {
          "type": "number"
        },
        "maximumQueueLength": {
          "type": "number"
        },
        "averageQueueLength": {
          "type": "number"
        },
        "totalEntered": {
          "type": "number"
        },
        "totalServed": {
          "type": "number"
        },
        "averageWaitingTime": {
          "type": "number"
        },
        "observedServiceRate": {
          "type": "number"
        },
        "cameraConfiguration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionId",
        "userId",
        "title",
        "locationLabel",
        "startTime",
        "endTime",
        "durationSeconds",
        "maximumQueueLength",
        "averageQueueLength",
        "totalEntered",
        "totalServed",
        "averageWaitingTime",
        "observedServiceRate",
        "cameraConfiguration",
        "modelVersion",
        "createdAt"
      ]
    },
    "QueueEvent": {
      "title": "QueueEvent",
      "description": "Anonymous queue entry, exit, or service completion event.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "enum": ["entry", "service_exit", "abandoned_exit"],
          "minLength": 1,
          "maxLength": 32
        },
        "anonymousTrackId": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "eventId",
        "sessionId",
        "userId",
        "eventType",
        "anonymousTrackId",
        "createdAt"
      ]
    },
    "PredictionRecord": {
      "title": "PredictionRecord",
      "description": "Periodic waiting-time prediction snapshot recorded during a session.",
      "type": "object",
      "properties": {
        "predictionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "queueCount": {
          "type": "number"
        },
        "peopleAhead": {
          "type": "number"
        },
        "observedServiceRate": {
          "type": "number"
        },
        "estimatedWaitingTime": {
          "type": "number"
        },
        "reliabilityLevel": {
          "type": "string",
          "enum": ["insufficient_data", "low", "moderate", "high"],
          "minLength": 1,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "predictionId",
        "sessionId",
        "userId",
        "queueCount",
        "peopleAhead",
        "observedServiceRate",
        "estimatedWaitingTime",
        "reliabilityLevel",
        "createdAt"
      ]
    },
    "UserPreferencesDoc": {
      "title": "UserPreferencesDoc",
      "description": "Operator camera, ROI, and confidence threshold settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "preferredCameraFacing": {
          "type": "string",
          "enum": ["environment", "user"],
          "minLength": 4,
          "maxLength": 16
        },
        "confidenceThreshold": {
          "type": "number"
        },
        "targetInferenceFps": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "preferredCameraFacing",
        "confidenceThreshold",
        "targetInferenceFps",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Operator profile isolated per authenticated UID."
    },
    "/queue_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/QueueSession" },
      "description": "Saved queue monitoring session summaries."
    },
    "/queue_events/{eventId}": {
      "schema": { "$ref": "#/entities/QueueEvent" },
      "description": "Anonymous queue entry and exit events."
    },
    "/prediction_history/{predictionId}": {
      "schema": { "$ref": "#/entities/PredictionRecord" },
      "description": "Snapshots of waiting-time predictions."
    },
    "/user_preferences/{userId}": {
      "schema": { "$ref": "#/entities/UserPreferencesDoc" },
      "description": "Operator camera and threshold preferences."
    }
  }
}
